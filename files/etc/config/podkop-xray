config settings 'settings'
        option dns_type 'doh'
        option dns_server 'https://dns.google/dns-query'
        option bootstrap_dns_server '8.8.8.8'
        option dns_rewrite_ttl '60'
        list source_network_interfaces 'br-lan'
        option enable_output_network_interface '0'
        #option output_network_interface 'wan'
        option enable_badwan_interface_monitoring '0'
        #list badwan_monitored_interfaces 'wan'
        #option badwan_reload_delay '2000'
        option disable_quic '0'
        option update_interval '1d'
        option download_lists_via_proxy '0'
        option dont_touch_dhcp '0'
        option config_path '/etc/xray/config.json'
        option log_level 'warning'
        option exclude_ntp '0'
        option shutdown_correctly '0'
        #list routing_excluded_ips '192.168.1.3'

config section 'main'
        option connection_type 'proxy'
        option proxy_config_type 'url'
        option proxy_string ''
        option rules_type 'block_direct_proxy'
        list geosite_direct 'INTERNAL-AVAILABLE-ONLY-INSIDE'
        list geosite_direct 'INTERNAL-BANK-RU'
        list geosite_direct 'INTERNAL-GOV-RU'
        list geosite_direct 'INTERNAL-PRIVATE'
        list geosite_direct 'INTERNAL-RU'
        list geoip_direct 'INTERNAL-DDOS-GUARD'
        list geoip_direct 'INTERNAL-PRIVATE'
        list geoip_direct 'INTERNAL-RU'
        list geoip_direct 'INTERNAL-RU-WHITELIST'
        list geoip_direct 'INTERNAL-YANDEX'
        #list fully_routed_ips '192.168.1.2'
        option mixed_proxy_enabled '1'
        option socks_proxy_port '10808'
        option http_proxy_port '10809'
