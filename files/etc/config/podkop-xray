config settings 'settings'
        option dns_type 'doh'
        option dns_server 'https://dns.google/dns-query'
        option bootstrap_dns_server '8.8.8.8'
        option dns_rewrite_ttl '60'
        list source_network_interfaces 'br-lan'
        option enable_output_network_interface '0'
        #option output_network_interface 'wan'
        option enable_badwan_interface_monitoring '0'
        #list badwan_monitored_interfaces 'wan'
        #option badwan_reload_delay '2000'
        option disable_quic '0'
        option update_interval '1d'
        option download_lists_via_proxy '0'
        option dont_touch_dhcp '0'
        option config_path '/etc/xray/config.json'
        option log_level 'warning'
        option exclude_ntp '0'
        option shutdown_correctly '0'
        #list routing_excluded_ips '192.168.1.3'

config section 'main'
        option connection_type 'proxy'
        option proxy_config_type 'url'
        option proxy_string ''
        option rules_type 'block_proxy_direct'
        list geosite_proxy 'RU-BLOCKED'
        list geosite_proxy 'ANTIFILTER-DOWNLOAD-COMMUNITY'
        list geosite_proxy 'CATEGORY-MEDIA'
        list geosite_proxy 'CATEGORY-COMMUNICATION'
        list geosite_proxy 'CATEGORY-ENTERTAINMENT'
        list geosite_proxy 'CATEGORY-GAMES'
        list geosite_proxy 'CATEGORY-DEV'
        list geosite_proxy 'CATEGORY-FORUMS'
        list geosite_proxy 'CATEGORY-ANTICENSORSHIP'
        list geosite_proxy 'CATEGORY-VPNSERVICES'
        list geosite_proxy 'CATEGORY-CRYPTOCURRENCY'
        list geosite_proxy 'CATEGORY-AI-!CN'
        list geosite_proxy 'CATEGORY-CDN-!CN'
        list geosite_proxy 'CATEGORY-SCHOLAR-!CN'
        list geosite_proxy 'CATEGORY-SOCIAL-MEDIA-!CN'
        list geosite_proxy 'GOOGLE'
        list geosite_proxy 'CLOUDFLARE'
        list geosite_proxy 'AMAZON'
        list geosite_direct 'CATEGORY-RU'
        list geosite_direct 'RU-AVAILABLE-ONLY-INSIDE'
        list geosite_direct 'CATEGORY-BANK-RU'
        list geosite_direct 'CATEGORY-GOV-RU'
        list geosite_block 'CATEGORY-ADS-ALL'
        list geosite_block 'PRIVATE'
        list geoip_proxy 'GOOGLE'
        list geoip_proxy 'RU-BLOCKED'
        list geoip_proxy 'TELEGRAM'
        list geoip_direct 'RU-WHITELIST'
        list geoip_direct 'YANDEX'
        #list fully_routed_ips '192.168.1.2'
        option mixed_proxy_enabled '1'
        option socks_proxy_port '10808'
        option http_proxy_port '10809'
